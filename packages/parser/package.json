{
  "name": "@pressbox/parser",
  "version": "1.0.0",
  "description": "Rematch video parser - extracts game state from POV footage",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scorebug": "npm run build && node dist/index.js --test-scorebug"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "fluent-ffmpeg": "^2.1.3",
    "munkres-js": "^1.2.2",
    "sharp": "^0.33.2",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
